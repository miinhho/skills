{
  "name": "context-memo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workspace-scoped execution state and continuation views",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check --formatter-enabled=false --error-on-warnings .",
    "lint:fix": "biome check --write --formatter-enabled=false .",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --plainVertical --out THIRD_PARTY_LICENSES.txt",
    "prebuild": "npm run licenses",
    "pretest": "npm run licenses",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@oclif/core": "5.1.12",
    "env-paths": "4.0.0",
    "proper-lockfile": "4.1.2",
    "write-file-atomic": "8.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/write-file-atomic": "4.0.3",
    "license-checker-rseidelsohn": "5.0.1",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
